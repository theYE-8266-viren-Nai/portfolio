---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, education, projects, skills, speaking, otherRepos } from '../data/site';

const freelance = projects.filter((p) => p.kind === 'freelance');
const hackathon = projects.filter((p) => p.kind === 'hackathon');
const academic = projects.filter((p) => p.kind === 'academic');

const stats = [
  { value: '9', label: 'shipped repositories' },
  { value: '6', label: 'languages in production' },
  { value: '2', label: 'paid client builds' },
  { value: '5', label: 'day hackathon sprint' },
];

const nav = [
  { href: '#work', label: 'Work' },
  { href: '#hackathons', label: 'Hackathons' },
  { href: '#coursework', label: 'Coursework' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<Base>
  <header class="nav">
    <div class="wrap nav__inner">
      <a href="#top" class="mono" style="text-decoration:none;color:var(--accent)">◉ thuriya</a>
      <nav aria-label="Sections">
        <ul class="nav__links mono">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- Hero ------------------------------------------------------------ -->
    <section class="hero">
      <div class="hero__aura" aria-hidden="true"></div>
      <div class="wrap">
        <p class="hero__eyebrow mono enter" style="--i:0">{profile.location}</p>
        <h1 class="hero__name enter" style="--i:1">{profile.name}</h1>
        <p class="hero__tagline enter" style="--i:2">{profile.tagline}</p>
        <div class="hero__intro enter" style="--i:3">
          {profile.intro.map((p) => <p>{p}</p>)}
        </div>
        <div class="hero__actions enter" style="--i:4">
          <a class="btn btn--primary" href={`mailto:${profile.email}`}>Get in touch</a>
          <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
    </section>

    <div class="wrap">
      <div class="stat-row stagger">
        {
          stats.map((s) => (
            <div class="stat">
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Freelance ------------------------------------------------------- -->
    <section class="section" id="work">
      <div class="wrap">
        <div class="section__head reveal">
          <h2 class="section__title">Freelance work</h2>
          <span class="section__count mono">paid client builds</span>
        </div>
        <div class="projects">
          {freelance.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>

    <!-- Hackathons ------------------------------------------------------ -->
    <section class="section" id="hackathons">
      <div class="wrap">
        <div class="section__head reveal">
          <h2 class="section__title">Hackathons</h2>
          <span class="section__count mono">built under deadline</span>
        </div>
        <div class="projects">
          {hackathon.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>

    <!-- Coursework ------------------------------------------------------ -->
    <section class="section" id="coursework">
      <div class="wrap">
        <div class="section__head reveal">
          <h2 class="section__title">Coursework</h2>
          <span class="section__count mono">university projects</span>
        </div>
        <div class="projects">
          {academic.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>

    <!-- Other repositories ----------------------------------------------- -->
    <section class="section" id="other">
      <div class="wrap">
        <div class="section__head reveal">
          <h2 class="section__title">Other repositories</h2>
          <span class="section__count mono">smaller in scope, still real</span>
        </div>
        <div class="repo-list stagger">
          {
            otherRepos.map((r) => (
              <a class="repo-item" href={r.href} target="_blank" rel="noopener noreferrer">
                <div>
                  <h3 class="repo-item__title">{r.title}</h3>
                  <p class="repo-item__desc">{r.description}</p>
                </div>
                <span class="repo-item__arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills ---------------------------------------------------------- -->
    <section class="section" id="skills">
      <div class="wrap">
        <div class="section__head reveal">
          <h2 class="section__title">Toolkit</h2>
          <span class="section__count mono">things I have actually shipped with</span>
        </div>
        <div class="skills reveal-up">
          {
            skills.map((g) => (
              <div class="skills__group">
                <h3 class="skills__name mono">{g.group}</h3>
                <ul class="tags">
                  {g.items.map((i) => (
                    <li class="tag">{i}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Education + speaking -------------------------------------------- -->
    <section class="section" id="about">
      <div class="wrap">
        <div class="section__head reveal">
          <h2 class="section__title">Education &amp; community</h2>
        </div>
        <div class="split stagger">
          <div class="panel">
            <h3>{education.school}</h3>
            <p class="mono" style="color:var(--accent);margin-top:.4rem">{education.graduation}</p>
            <div class="dl">
              <p>{education.degree}</p>
              <p style="color:var(--text-faint)">Relevant coursework</p>
              <ul class="tags">
                {education.coursework.map((c) => <li class="tag">{c}</li>)}
              </ul>
            </div>
          </div>

          <div class="panel">
            <h3>{speaking.role} — {speaking.org}</h3>
            <p class="mono" style="color:var(--accent);margin-top:.4rem">{speaking.date}</p>
            <div class="dl">
              <p style="color:var(--text)">“{speaking.title}”</p>
              <p>{speaking.detail}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact --------------------------------------------------------- -->
    <section class="section contact" id="contact">
      <div class="wrap reveal">
        <p class="mono" style="color:var(--accent)">Open to internships</p>
        <a class="contact__mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <p style="color:var(--text-dim);max-width:52ch;margin-inline:auto">
          Currently in my final year at UIT and looking for a software engineering internship.
          The fastest way to reach me is email.
        </p>
      </div>
    </section>

    <footer class="wrap footer mono">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a> ·
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a> ·
        <a href={`mailto:${profile.email}`}>Email</a> ·
        <a href="https://github.com/theYE-8266-viren-Nai/portfolio" target="_blank" rel="noopener noreferrer">Source</a>
      </span>
    </footer>
  </main>
</Base>

---
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card reveal-up">
  <div class="card__top">
    <div>
      <h3 class="card__title">{project.title}</h3>
      <p class="card__subtitle">{project.subtitle}</p>
    </div>
    <div class="card__meta mono">
      <div>{project.period}</div>
      {project.role && <div>{project.role}</div>}
    </div>
  </div>

  <p class="card__summary">{project.summary}</p>

  <div class="card__body">
    <ul class="card__list">
      {project.highlights.map((h) => <li>{h}</li>)}
    </ul>

    <div class="card__side">
      {
        project.metric && (
          <div class="metric">
            <span class="metric__value">{project.metric.value}</span>
            <span class="metric__label">{project.metric.label}</span>
          </div>
        )
      }
      <ul class="tags">
        {project.stack.map((s) => <li class="tag">{s}</li>)}
      </ul>
    </div>
  </div>

  <div class="card__links">
    {
      project.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer">
          {l.label}
        </a>
      ))
    }
  </div>
</article>
